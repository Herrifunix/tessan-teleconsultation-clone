{
  "name": "tessan-teleconsultation-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens": "node tools/build-tokens.mjs && node tools/gen-tokens-css.mjs",
    "build": "node tools/gen-tokens-css.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "capture:clone": "node tools/capture-clone.mjs",
    "diff": "node tools/diff.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:e2e && npm run capture:clone && npm run diff",
    "done-check": "node tools/check-checklist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "5.2.8",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supercluster": "7.1.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "undici": "8.11.2",
    "vite": "7.3.6"
  },
  "description": "Reproduction du localisateur de dispositifs de téléconsultation Tessan (test technique — non affiliée à Tessan)",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "supercluster": "9.1.0"
  }
}
